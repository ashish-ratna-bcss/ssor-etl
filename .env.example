# Local PostgreSQL configuration used by the ETL code and Docker Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cctns_etl
POSTGRES_USER=cctns_local
POSTGRES_PASSWORD=cctns_local_password

# Optional connection source selector.
DB_CONFIG_SOURCE=POSTGRES

# pgAdmin access for the local admin UI.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# Application API settings.
DOPAMAS_API_URL=http://your-api-host:3000/api/DOPAMS
DOPAMAS_API_KEY=your_api_key_here

# Application defaults.
DEBUG=True
LOG_LEVEL=INFO
